+        case .unavailable:
+            return .unavailable
+        case .stale:
+            guard let value = slot.valueText else { return .unavailable }
+            return .stale(progress: slot.progress ?? 0, centerText: value)
+        case .available:
+            guard let value = slot.valueText else { return .setupRequired }
+            let progress = slot.progress ?? 0
