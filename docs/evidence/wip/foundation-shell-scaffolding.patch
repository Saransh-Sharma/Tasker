+/// Shell-owned `@State` that has to travel into the section structs.
+///
+/// Bundling the bindings keeps each section's parameter list to the handful of
+/// things it actually reads, and keeps the shell's own call sites one line
+/// each.
+private struct FoundationShellBindings {
+    let captureState: Binding<CaptureOrbPresentationState>
+    let captureRippleTrigger: Binding<Int>
+    let measuredChromeHeight: Binding<CGFloat>
+    let visitedRoots: Binding<Set<LifeBoardDestination>>
+    let homeCardPlacementRequest: Binding<HomeCardPlacementRequest?>
+    let showsHomeDisplayPanel: Binding<Bool>
+    let homeIsCustomizing: Binding<Bool>
+    let routeTransitionTrigger: Binding<Int>
+    let daypartBloomTrigger: Binding<Int>
+    let planRescueRefreshGeneration: Binding<Int>
+}
