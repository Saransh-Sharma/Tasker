+        while continuation == nil { await _Concurrency.Task.yield() }
+        let stop = _Concurrency.Task { await coordinator.stopAutomaticActivation() }
+        while coordinator.automaticActivationAllowed { await _Concurrency.Task.yield() }
+        continuation?.resume()
