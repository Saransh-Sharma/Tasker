{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.getlifeboard.app/schemas/eva/inference-request-v1.json",
  "title": "EvaInferenceRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId", "route", "contractVersion", "locale", "timeZone",
    "messages", "context", "clientVersion", "platform",
    "installationId", "consentRevision", "providerCapabilities"
  ],
  "properties": {
    "requestId": { "type": "string", "format": "uuid" },
    "route": {
      "enum": [
        "chat", "plan", "planRepair", "fieldSuggestion", "topThree",
        "taskBreakdown", "dailyBrief", "universalInputClassification",
        "dynamicChips", "journalAnswer", "knowledgeAnswer",
        "shortcutsAnswer", "debugSmoke"
      ]
    },
    "contractVersion": { "const": 1 },
    "locale": { "type": "string", "minLength": 2, "maxLength": 64 },
    "timeZone": { "type": "string", "minLength": 1, "maxLength": 128 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
        }
      }
    },
    "context": { "type": "array", "maxItems": 5 },
    "clientVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "platform": { "enum": ["ios", "catalyst"] },
    "installationId": { "type": "string", "format": "uuid" },
    "consentRevision": { "type": "integer", "minimum": 0 },
    "providerCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streaming", "structuredOutput", "spokenOutput"],
      "properties": {
        "streaming": { "type": "boolean" },
        "structuredOutput": { "type": "boolean" },
        "spokenOutput": { "type": "boolean" }
      }
    }
  }
}
