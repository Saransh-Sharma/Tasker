#!/usr/bin/env bash
# Shared repository paths for structural-refactor guardrails.
#
# This file is sourced by scripts; keep it free of side effects and shell options.

LIFEBOARD_ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIFEBOARD_PROJECT_FILE="$LIFEBOARD_ROOT_DIR/LifeBoard.xcodeproj/project.pbxproj"
LIFEBOARD_WORKSPACE="$LIFEBOARD_ROOT_DIR/LifeBoard.xcworkspace"
LIFEBOARD_TARGET_MEMBERSHIP_ALLOWLIST="$LIFEBOARD_ROOT_DIR/scripts/xcode-target-membership-allowlist.txt"
LIFEBOARD_TARGET_MEMBERSHIP_EXCLUSIONS="$LIFEBOARD_ROOT_DIR/scripts/xcode-target-membership-exclusions.txt"
LIFEBOARD_LOCALIZATION_CATALOG="$LIFEBOARD_ROOT_DIR/LifeBoard/Localizable.xcstrings"
LIFEBOARD_ACCESSIBILITY_SNAPSHOT="$LIFEBOARD_ROOT_DIR/scripts/accessibility-identifiers.sha256"
LIFEBOARD_LOCALIZATION_SNAPSHOT="$LIFEBOARD_ROOT_DIR/scripts/localization-keys.sha256"
LIFEBOARD_SWIFTLINT_BASELINE="$LIFEBOARD_ROOT_DIR/scripts/swiftlint-baseline.txt"

LIFEBOARD_SWIFT_SOURCE_ROOTS=(
  "LifeBoard"
  "LifeBoardTests"
  "LifeBoardUITests"
  "LifeBoardWatch"
  "LifeBoardWatchWidgets"
  "LifeBoardWidgets"
  "Shared"
)
