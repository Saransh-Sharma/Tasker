<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EVACloudBaseURL</key>
	<string>$(EVA_CLOUD_BASE_URL)</string>
	<key>EVAConfigSigningPublicKey</key>
	<string>$(EVA_CONFIG_SIGNING_PUBLIC_KEY)</string>
	<key>EVACloudEnvironment</key>
	<string>$(EVA_CLOUD_ENVIRONMENT)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lifeboard.refresh.occurrences</string>
		<string>com.lifeboard.refresh.reminders</string>
		<string>com.lifeboard.refresh.daily_brief</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>LifeBoard</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.saransh1337.lifeboard.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lifeboard</string>
				<string>tasker</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>LifeBoard syncs your tasks with the Reminders lists you choose.</string>
	<key>NSRemindersUsageDescription</key>
	<string>LifeBoard syncs your tasks with the Reminders lists you choose.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>LifeBoard shows your events next to your tasks to help you plan your day.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>LifeBoard shows your events next to your tasks to help you plan your day.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>LifeBoard uses Face ID to unlock your journal and locked notes.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>LifeBoard shows the Health data you choose, like sleep, steps, and workouts, alongside your day.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>LifeBoard saves the water, meals, body measurements, and workouts you log to Apple Health.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>LifeBoard uses the microphone when you dictate or record audio in your journal.</string>
	<key>NSCameraUsageDescription</key>
	<string>LifeBoard uses the camera to scan documents and food barcodes.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LifeBoard adds the photos you choose to journal entries and notes.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>LifeBoard turns your voice into text when you dictate or transcribe a recording.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UISupportsAssistiveAccess</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
